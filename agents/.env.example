# vps-secure-agents — config
# Copy to .env and fill values.
# DO NOT commit .env to git.

# ── LLM (OpenRouter, see https://openrouter.ai/keys) ─────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modèle par défaut pour les agents. Recommandé: small + fast + JSON-compliant.
# Alternatives testées OK: anthropic/claude-sonnet-4, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct
LLM_MODEL=anthropic/claude-sonnet-4
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# ── Telegram ──────────────────────────────────────────────────────
# Crée le bot via @BotFather, récupère le token, puis envoie /start au bot
# Récupère ton chat_id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=6433792390

# ── Paths ─────────────────────────────────────────────────────────
# Répertoire racine du projet (où se trouvent agents/, canon/, state/)
VPS_SECURE_AGENTS_HOME=/home/vpsadmin/vps-secure-agents
STATE_DIR=/home/vpsadmin/vps-secure-agents/state
LOG_DIR=/var/log/vps-secure-agents

# ── Schedule ──────────────────────────────────────────────────────
# Timezone locale pour cron + logs
TZ=Europe/Paris

# ── Mode ──────────────────────────────────────────────────────────
# dry_run=true → ne fait AUCUN LLM call + AUCUN Telegram send.
#                 Génère juste les JSON dans state/ pour inspection.
DRY_RUN=false
# verbose=true → logs DEBUG
VERBOSE=false
