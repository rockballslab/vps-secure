# ── Security: never commit credentials ────────────────────────────
.env
.env.*
!.env.example

# ── Runtime state (machine-specific, regenerated each run) ────────
state/*.json
state/*.lock
!state/.gitkeep

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Virtual envs ──────────────────────────────────────────────────
.venv/
venv/
env/
.python-version

# ── Tests / tooling ──────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# ── IDE / OS ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────
*.log
logs/
